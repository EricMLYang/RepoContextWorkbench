{
  "work": [
    {
      "name": "where_am_i",
      "description": "我在哪：cwd 屬於哪個已登記 repo、哪些組、預設工作範圍是什麼。沒登記會告訴你怎麼登記。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cwd": {
            "type": "string",
            "description": "用哪個目錄推主場；省略＝server 啟動目錄（通常就是你的專案）"
          }
        },
        "required": []
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "context_for",
      "description": "這個範圍的完整脈絡：目標、上次交接、建議下一步、未結事項（帶 id）、最近事件（帶 ref）、關係、需要注意的 repo、agent 狀態。開場注入已經給了摘要（交接、未結、同組成員）——要更多細節、或做到一半要重抓時才呼叫。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cwd": {
            "type": "string",
            "description": "用哪個目錄推主場；省略＝server 啟動目錄（通常就是你的專案）"
          },
          "group": {
            "type": "string",
            "description": "組名；省略＝依 cwd 推出的主場"
          },
          "repos": {
            "type": "string",
            "description": "逗號分隔 repo id（臨時組合，優先於 group）"
          },
          "card": {
            "type": "boolean",
            "description": "是否另附 markdown 情境卡（內容跟其他欄位相同；預設 false）"
          }
        },
        "required": []
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "next_work",
      "description": "接下來值得做什麼（依序：上次交接的下一步 → 逾期未結 → 其他未結 → 擱置太久的 → 需要注意的 repo），每項都附 why。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cwd": {
            "type": "string",
            "description": "用哪個目錄推主場；省略＝server 啟動目錄（通常就是你的專案）"
          },
          "group": {
            "type": "string",
            "description": "組名；省略＝依 cwd 推出的主場"
          },
          "repos": {
            "type": "string",
            "description": "逗號分隔 repo id（臨時組合，優先於 group）"
          },
          "limit": {
            "type": "integer",
            "description": "最多幾項，預設 5"
          }
        },
        "required": []
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "log_decision",
      "description": "記下一個判斷或結論（為什麼這樣做、依據哪份檔）。回傳 ref，之後可引用。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "判斷內容；第一行寫結論，後面寫依據"
          },
          "ref": {
            "type": "string",
            "description": "相關事件的 ref（例 decision:2026-09-25-d1、collision:2026-09-25-a）"
          },
          "supersedes": {
            "type": "string",
            "description": "這筆判斷取代哪一筆（decision:<id>）；被取代的之後不再出現在最近事件"
          },
          "reopen_when": {
            "type": "string",
            "description": "什麼情況要重看這個判斷（例：repo 超過 50 個、2026-12-01 前）；寫日期會在到期時提醒"
          },
          "outcome_of": {
            "type": "string",
            "description": "這段文字是哪一筆判斷後來的結果（decision:<id>）；會寫成結果（outcome）並指回它"
          },
          "cwd": {
            "type": "string",
            "description": "用哪個目錄推主場；省略＝server 啟動目錄（通常就是你的專案）"
          },
          "group": {
            "type": "string",
            "description": "組名；省略＝依 cwd 推出的主場"
          },
          "repos": {
            "type": "string",
            "description": "逗號分隔 repo id（臨時組合，優先於 group）"
          },
          "cross_scope_ok": {
            "type": "boolean",
            "description": "寫入主場以外的範圍。只有在使用者明確同意後才設 true"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "add_todo",
      "description": "開一個未結事項（之後要有人處理的事）。編號自動配；有真實期限才給 due，沒給就沒有期限。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "要做的事，一句話"
          },
          "due": {
            "type": "string",
            "description": "YYYY-MM-DD，可省略"
          },
          "cwd": {
            "type": "string",
            "description": "用哪個目錄推主場；省略＝server 啟動目錄（通常就是你的專案）"
          },
          "group": {
            "type": "string",
            "description": "組名；省略＝依 cwd 推出的主場"
          },
          "repos": {
            "type": "string",
            "description": "逗號分隔 repo id（臨時組合，優先於 group）"
          },
          "cross_scope_ok": {
            "type": "boolean",
            "description": "寫入主場以外的範圍。只有在使用者明確同意後才設 true"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "close_todo",
      "description": "關掉一個未結事項（用 context_for／next_work 回傳的 id，例 #3）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "未結事項編號，例 #3"
          },
          "note": {
            "type": "string",
            "description": "怎麼結的，一句話"
          },
          "cwd": {
            "type": "string",
            "description": "用哪個目錄推主場；省略＝server 啟動目錄（通常就是你的專案）"
          },
          "cross_scope_ok": {
            "type": "boolean",
            "description": "寫入主場以外的範圍。只有在使用者明確同意後才設 true"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "tidy_todos",
      "description": "未結清理（使用者說「幫我清未結」時用）。不帶 close＝把範圍內的未結分成 done（可能已做完，附證據）／shelved（擱置太久）／ask（等使用者決定）／live（還在進行），並回 suggest_close。帶 close（編號陣列）＝一次關一批。先把要關的列給使用者看，他同意才帶 close。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "close": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "要關掉的未結編號，例 [\"#3\", \"#7\"]；省略＝只列不關"
          },
          "note": {
            "type": "string",
            "description": "怎麼結的，一句話（整批共用）"
          },
          "cwd": {
            "type": "string",
            "description": "用哪個目錄推主場；省略＝server 啟動目錄（通常就是你的專案）"
          },
          "group": {
            "type": "string",
            "description": "組名；省略＝依 cwd 推出的主場"
          },
          "repos": {
            "type": "string",
            "description": "逗號分隔 repo id（臨時組合，優先於 group）"
          },
          "cross_scope_ok": {
            "type": "boolean",
            "description": "寫入主場以外的範圍。只有在使用者明確同意後才設 true"
          }
        },
        "required": []
      }
    },
    {
      "name": "report_status",
      "description": "回報你現在的階段，讓使用者在工作台一眼看出輪到誰：working／waiting（等使用者回應）／blocked（卡住）／done。waiting 與 blocked 會進使用者的收件匣。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "目前階段",
            "enum": [
              "working",
              "waiting",
              "blocked",
              "done"
            ]
          },
          "text": {
            "type": "string",
            "description": "在做什麼／在等什麼／卡在哪"
          },
          "cwd": {
            "type": "string",
            "description": "用哪個目錄推主場；省略＝server 啟動目錄（通常就是你的專案）"
          },
          "group": {
            "type": "string",
            "description": "組名；省略＝依 cwd 推出的主場"
          },
          "repos": {
            "type": "string",
            "description": "逗號分隔 repo id（臨時組合，優先於 group）"
          }
        },
        "required": [
          "status"
        ]
      }
    },
    {
      "name": "request_decision",
      "description": "做到一半需要使用者決定時先呼叫（不要直接停下來問）。使用者同意過這類自動放行時回 {decision:\"auto\", answer}：照 answer 接著做，不用停；否則回 {decision:\"wait\", reason}：能做的先做完，收尾 handoff 帶同一個 ask。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "description": "一句不看程式也答得出來的問題"
          },
          "kind": {
            "type": "string",
            "description": "類別；省略＝other",
            "enum": [
              "commit",
              "content_review",
              "config_change",
              "choose",
              "visual_check",
              "manual_test",
              "push",
              "publish",
              "delete",
              "send_external",
              "other"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "選項（使用者用 1 起算的編號回答）"
          },
          "recommend": {
            "type": "string",
            "description": "你建議的選項（文字或編號）"
          },
          "reversible": {
            "type": "boolean",
            "description": "做了收得回來嗎；預設 true"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "要看的檔：repo 內相對路徑或 <repo>:<路徑>"
          },
          "cwd": {
            "type": "string",
            "description": "用哪個目錄推主場；省略＝server 啟動目錄（通常就是你的專案）"
          },
          "cross_scope_ok": {
            "type": "boolean",
            "description": "寫入主場以外的範圍。只有在使用者明確同意後才設 true"
          }
        },
        "required": [
          "question"
        ]
      }
    },
    {
      "name": "handoff",
      "description": "收尾交接（每次會話結束前必呼叫）：完成了什麼、下次從哪接。下一個 agent 的開場與 context_for／next_work 會讀到它。remaining 只是交接裡的一行備註，不會開未結；要追蹤的事另外呼叫 add_todo。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "done": {
            "type": "string",
            "description": "這次完成了什麼（成果、改了哪些檔）"
          },
          "next_step": {
            "type": "string",
            "description": "下次從哪裡接，一句話"
          },
          "remaining": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "可省略：沒做完的事，只寫進交接文字，不開未結"
          },
          "ask": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string",
                "description": "一句不看程式也答得出來的問題"
              },
              "kind": {
                "type": "string",
                "description": "類別；省略＝other",
                "enum": [
                  "commit",
                  "content_review",
                  "config_change",
                  "choose",
                  "visual_check",
                  "manual_test",
                  "push",
                  "publish",
                  "delete",
                  "send_external",
                  "other"
                ]
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "選項（使用者用 1 起算的編號回答）"
              },
              "recommend": {
                "type": "string",
                "description": "你建議的選項（文字或編號）"
              },
              "reversible": {
                "type": "boolean",
                "description": "做了收得回來嗎；預設 true"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "要看的檔：repo 內相對路徑或 <repo>:<路徑>"
              }
            },
            "required": [
              "question"
            ],
            "description": "可省略：下一步在等使用者決定／確認／驗收時才填，使用者會在決策佇列（ctx decide）看到並用編號回答；這類已設成自動放行時回傳多 auto（就是答案）。好：「首頁排序要改成依修改時間（A）還是維持依名稱（B）？」；差：「要繼續嗎？」"
          },
          "cwd": {
            "type": "string",
            "description": "用哪個目錄推主場；省略＝server 啟動目錄（通常就是你的專案）"
          },
          "group": {
            "type": "string",
            "description": "組名；省略＝依 cwd 推出的主場"
          },
          "repos": {
            "type": "string",
            "description": "逗號分隔 repo id（臨時組合，優先於 group）"
          },
          "cross_scope_ok": {
            "type": "boolean",
            "description": "寫入主場以外的範圍。只有在使用者明確同意後才設 true"
          }
        },
        "required": [
          "done",
          "next_step"
        ]
      }
    },
    {
      "name": "send_message",
      "description": "對講：傳話給同組另一個 repo 的 agent（請它做事、問它介面、告訴它你改了共用的東西），或帶 re 回覆收到的訊息。那個 repo 有會話在跑就送進它的脈絡（它用完下一個工具時），沒有就進使用者收件匣、那邊下次開場看到；對方的回覆會送回你這場會話。不用等回覆，繼續手上的事。跨組要先問使用者再帶 cross_scope_ok。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "description": "收件 repo id（同組成員見 context_for 的 roster）；回覆時可省略"
          },
          "text": {
            "type": "string",
            "description": "要說的話：要什麼、為什麼、做完怎樣算好；長內容寫成檔、這裡放路徑"
          },
          "re": {
            "type": "string",
            "description": "回覆哪一則（訊息編號，例 2026-11-04-m1）"
          },
          "cwd": {
            "type": "string",
            "description": "用哪個目錄推主場；省略＝server 啟動目錄（通常就是你的專案）"
          },
          "cross_scope_ok": {
            "type": "boolean",
            "description": "寫入主場以外的範圍。只有在使用者明確同意後才設 true"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "messages",
      "description": "對講收件匣：別的 repo 的 agent 傳給你這個 repo 的話（新的這次算收到）與你送出的，加上同組現在在跑的 agent（repo、標題、在做什麼）——要改共用的東西前先看誰在動。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "最多幾則，預設 10"
          },
          "cwd": {
            "type": "string",
            "description": "用哪個目錄推主場；省略＝server 啟動目錄（通常就是你的專案）"
          }
        },
        "required": []
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "describe_repo",
      "description": "寫 repo 的名片：一句話介紹、協作角色、搜尋關鍵字。組員名冊與 search_knowledge 的 repo 排名都靠它；存在 spine（registry），不會寫進 repo。開場名冊標「推測自 README」或沒有介紹時，做完手上的事順手補。只能改主場（所在 repo＋同組成員）；空字串／空陣列＝清掉該欄。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "repo id；省略＝你所在的 repo"
          },
          "description": {
            "type": "string",
            "description": "一句話：這個 repo 是什麼、別的 repo 會來這裡找什麼"
          },
          "role": {
            "type": "string",
            "description": "協作角色，一個短詞（例 知識庫、規格來源、實作）"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "搜尋用關鍵字（tags 是給人分類的，別重複）"
          },
          "cwd": {
            "type": "string",
            "description": "用哪個目錄推主場；省略＝server 啟動目錄（通常就是你的專案）"
          },
          "cross_scope_ok": {
            "type": "boolean",
            "description": "寫入主場以外的範圍。只有在使用者明確同意後才設 true"
          }
        },
        "required": []
      }
    },
    {
      "name": "workbench_apply",
      "description": "改工作台設定（跟 App 助手同一份白名單）：建組 create_group、設組員 set_members、改名 rename_group、組目標 set_goal、標籤 tag、分層 set_tier、類別 set_class（code／agent／data／docs／knowledge／reference）。steps＝[{op, args}]；預設只回預覽，給使用者看過、同意後帶 confirm=true 才執行。碰到主場以外的 repo 要使用者同意（cross_scope_ok）。換範圍、切分頁等畫面動作只在 App 做。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "[{op, args}]，例 [{\"op\":\"tag\",\"args\":{\"id\":\"repo-a\",\"add\":[\"規格\"]}}]"
          },
          "confirm": {
            "type": "boolean",
            "description": "使用者看過預覽並同意後才設 true"
          },
          "cwd": {
            "type": "string",
            "description": "用哪個目錄推主場；省略＝server 啟動目錄（通常就是你的專案）"
          },
          "cross_scope_ok": {
            "type": "boolean",
            "description": "寫入主場以外的範圍。只有在使用者明確同意後才設 true"
          }
        },
        "required": [
          "steps"
        ]
      }
    },
    {
      "name": "search_knowledge",
      "description": "要別的 repo 的資訊先問誰有：最該去的 repo、起點、判斷、下一步。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "要比對的文字"
          },
          "detail": {
            "type": "string",
            "description": "預設 brief",
            "enum": [
              "brief",
              "full"
            ]
          },
          "everywhere": {
            "type": "boolean",
            "description": "true（預設）＝搜全部 repo；false＝只搜主場範圍"
          },
          "code": {
            "type": "boolean",
            "description": "是否也搜程式碼（預設 true）"
          },
          "limit": {
            "type": "integer",
            "description": "最多回幾個檔，預設 8"
          },
          "cwd": {
            "type": "string",
            "description": "用哪個目錄推主場；省略＝server 啟動目錄（通常就是你的專案）"
          },
          "group": {
            "type": "string",
            "description": "組名；省略＝依 cwd 推出的主場"
          },
          "repos": {
            "type": "string",
            "description": "逗號分隔 repo id（臨時組合，優先於 group）"
          }
        },
        "required": [
          "query"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
